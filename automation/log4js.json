{
  "appenders": {
    "file": {
      "type": "file",
      "filename": "logs/test_execution.log",
      "maxLogSize": 10485760,
      "backups": 3,
      "compress": true,
      "layout": {
        "type": "pattern",
        "pattern": "%d{yyyy-MM-dd hh:mm:ss.SSS} [%p] %c - %m"
      }
    },
    "console": {
      "type": "console",
      "layout": {
        "type": "pattern",
        "pattern": "%d{yyyy-MM-dd hh:mm:ss.SSS} [%p] %c - %m"
      }
    }
  },
  "categories": {
    "default": {
      "appenders": ["file", "console"],
      "level": "debug"
    }
  }
}
